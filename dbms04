 SELECT product, COUNT(*) AS total_orders 
       FROM Orders 
       GROUP BY product; 

SELECT city, SUM(amount) AS total_sales 
       FROM Orders 
       GROUP BY city; 

SELECT product, AVG(amount) AS avg_price 
       FROM Orders 
       GROUP BY product 
       HAVING AVG(amount) > 30000; 

SELECT city, COUNT(*) AS orders_count 
       FROM Orders 
       GROUP BY city 
       HAVING COUNT(*) > 1; 

SELECT product, SUM(amount) AS total_sales 
       FROM Orders 
       GROUP BY product 
       HAVING SUM(amount) > 70000; 







