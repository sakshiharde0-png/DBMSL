
CREATE DATABASE CollegeDB;

USE CollegeDB;

CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    name VARCHAR(100),
    salary INT
);

INSERT INTO Employee VALUES (1, 'Amit', 50000);
INSERT INTO Employee VALUES (2, 'Neha', 60000);

CREATE USER 'user1'@'localhost' IDENTIFIED BY 'password123';
CREATE USER 'user2'@'localhost' IDENTIFIED BY 'password123';

GRANT SELECT, INSERT ON CollegeDB.Employee TO 'user1'@'localhost';

GRANT SELECT ON CollegeDB.Employee TO 'user2'@'localhost';

GRANT UPDATE ON CollegeDB.Employee TO 'user1'@'localhost';

REVOKE INSERT ON CollegeDB.Employee FROM 'user1'@'localhost';

REVOKE UPDATE ON CollegeDB.Employee FROM 'user1'@'localhost';

CREATE ROLE 'read_role';
CREATE ROLE 'write_role';

GRANT SELECT ON CollegeDB.Employee TO 'read_role';
GRANT INSERT, UPDATE, DELETE ON CollegeDB.Employee TO 'write_role';

GRANT 'read_role' TO 'user2'@'localhost';
GRANT 'write_role' TO 'user1'@'localhost';

SET DEFAULT ROLE 'read_role' TO 'user2'@'localhost';

REVOKE 'write_role' FROM 'user1'@'localhost';

DROP ROLE 'read_role';
DROP ROLE 'write_role';

