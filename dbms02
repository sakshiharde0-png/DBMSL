
CREATE DATABASE CollegeDB;

USE CollegeDB;

CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    name VARCHAR(100),
    salary INT,
    bonus INT,
    dept_id INT
);


INSERT INTO Employee VALUES (1, 'Amit', 50000, 5000, 1);
INSERT INTO Employee VALUES (2, 'Neha', 60000, 6000, 2);
INSERT INTO Employee VALUES (3, 'Rahul', 45000, 4000, 1);
INSERT INTO Employee VALUES (4, 'Priya', 70000, 7000, 3);

SELECT emp_id, name, salary + bonus AS total_income
FROM Employee;

SELECT emp_id, name, salary - 5000 AS reduced_salary
FROM Employee;

SELECT emp_id, name, salary * 12 AS annual_salary
FROM Employee;

SELECT emp_id, name, salary / 12 AS monthly_avg
FROM Employee;

UPDATE Employee
SET salary = salary + (salary * 0.10);

UPDATE Employee
SET bonus = bonus + 1000
WHERE dept_id = 1;

DELETE FROM Employee
WHERE salary < 50000;

DELETE FROM Employee
WHERE (salary + bonus) < 60000;
