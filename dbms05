USE Hemant; Database changed mysql> CREATE TABLE Department ( 
           dept_id INT PRIMARY KEY, 
           dept_name VARCHAR(50) 
      ); 

mysql> CREATE TABLE Employee (    
           emp_id INT PRIMARY KEY, 
           name VARCHAR(100), 
           salary INT, 
           dept_id INT 
       ); 

