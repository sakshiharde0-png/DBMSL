
CREATE DATABASE CollegeDB;

USE CollegeDB;

CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    name VARCHAR(100),
    dept VARCHAR(50),
    salary INT
);

INSERT INTO Employee VALUES (1, 'Amit', 'IT', 50000);
