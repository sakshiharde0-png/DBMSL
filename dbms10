SELECT name, salary
FROM Employee
WHERE salary > (SELECT AVG(salary) FROM Employee);

SELECT name, dept_id
FROM Employee
WHERE dept_id = (SELECT dept_id FROM Department WHERE dept_name = 'IT');

SELECT dept_name
FROM Department
WHERE dept_id IN (SELECT DISTINCT dept_id FROM Employee);

SELECT name, salary
FROM Employee
WHERE salary = (SELECT MAX(salary) FROM Employee);

FROM Employee
WHERE dept_id IN (
    SELECT dept_id
    FROM Employee
    WHERE salary > 55000
);

SELECT name
FROM Employee
WHERE dept_id NOT IN (
    SELECT dept_id
    FROM Department
    WHERE dept_name = 'HR'
);

SELECT e1.name, e1.salary
FROM Employee e1
WHERE e1.salary > (
    SELECT AVG(e2.salary)
    FROM Employee e2
    WHERE e1.dept_id = e2.dept_id
);

