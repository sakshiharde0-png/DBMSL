       (1, 'Sales'), 
       (2, 'Marke ng'), 
       (3, 'IT'); 

SELECT * FROM Departments; 

CREATE TABLE Employees ( 
       Employee_ID INT PRIMARY KEY,     
       Name VARCHAR(50) NOT NULL, 
       Salary DECIMAL(10, 2) NOT NULL, 
       Department VARCHAR(50) NOT NULL  ); 

