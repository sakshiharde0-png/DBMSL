UPDATE Employee
SET salary = 52000
WHERE emp_id = 1;

UPDATE Employee
SET salary = 75000
WHERE dept_id = 30;

DELETE FROM Employee
WHERE emp_id = 2;

DELETE FROM Employee
WHERE salary < 50000;

SELECT emp_id, name, salary, dept_id FROM Employee
UNION
SELECT emp_id, name, salary, dept_id FROM Employee_Backup;

SELECT emp_id, name, salary, dept_id FROM Employee
UNION ALL
SELECT emp_id, name, salary, dept_id FROM Employee_Backup;

SELECT e.emp_id, e.name, e.salary, e.dept_id
FROM Employee e
INNER JOIN Employee_Backup b
ON e.emp_id = b.emp_id;

SELECT e.emp_id, e.name, e.salary, e.dept_id
FROM Employee e
LEFT JOIN Employee_Backup b
ON e.emp_id = b.emp_id
WHERE b.emp_id IS NULL;
