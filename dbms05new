
CREATE DATABASE CollegeDB;

USE CollegeDB;

CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    name VARCHAR(100),
    salary INT,
    dept_id INT
);

CREATE TABLE Employee_Backup (
    emp_id INT PRIMARY KEY,
    name VARCHAR(100),
    salary INT,
    dept_id INT
);

