CREATE DATABASE Hemant; 

USE Hemant;

CREATE TABLE Employee (     
    ->     emp_id INT PRIMARY KEY, 
    ->     name VARCHAR(100), 
    ->     salary INT 
    -> ); 
 
CREATE TABLE Salary_Log ( 
    ->     log_id INT AUTO_INCREMENT PRIMARY KEY, 
    ->     emp_id INT, 
    ->     old_salary INT, 
    ->     new_salary INT 
    -> ); 
 
